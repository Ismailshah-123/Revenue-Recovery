# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# ---------------- APP ----------------
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:8501

# ---------------- SECURITY ----------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-32-plus-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------- DATABASE ----------------
# Local development (SQLite):
DATABASE_URL=sqlite:///./app.db
# Production (Postgres) example:
# DATABASE_URL=postgresql://user:password@host:5432/revenue_recovery

# ---------------- GMAIL (optional until you connect an inbox) ----------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# ---------------- AI ----------------
# OpenAI API key. Leave blank to run with the built-in fallback insights
# (no external calls) -- useful for local development and CI.
AI_API_KEY=

# MVP_MODE=true disables billing enforcement and the background scheduler,
# and stubs the checkout endpoint. Set to false for a real production launch.
MVP_MODE=true

# ---------------- FEATURE LIMITS ----------------
MAX_EMAIL_THREADS=20
MAX_AI_CALLS=50

# ---------------- BILLING / STRIPE (only needed once MVP_MODE=false) ----------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
